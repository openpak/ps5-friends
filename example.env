# HTTP listen address. Plain HTTP; Traefik terminates TLS for m.np.playstation.com and routes the
# friends/blocks/basicPresences path prefixes here.
PS5_ADDR=:8080

# Required. HMAC key shared with ps5-auth (the service that signs the bearer tokens), at least 32 bytes.
PS5_TOKEN_KEY=

# PS5_LOG_LEVEL=info
